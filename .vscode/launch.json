{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Start website",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/tools/serve.mjs",
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": {
        "pattern": "Local: (https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ]
}
